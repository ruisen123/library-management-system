# LibMS 容器部署环境变量模板
# 复制为 .env 后填写；.env 不要提交、不要外发
#   cp .env.example .env

# —— 必填 ——
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# JWT 签名密钥，长度必须 >= 32 字节；生成示例：
#   openssl rand -base64 48
# 这里故意留空：复制模板后若不填写，docker compose 会直接报错退出，
# 避免用模板里的公开占位值启动（JwtUtils 只校验长度，占位值同样能通过）。
JWT_SECRET=

# —— 可选（留默认即可跑通）——
MYSQL_DATABASE=library_db
MYSQL_USER=libms
WEB_PORT=8088
JWT_EXPIRE=86400000
# 前端来源（逗号分隔）。换端口/域名必须同步，否则浏览器登录会 403 Invalid CORS request；
# 留空则 compose 默认按 WEB_PORT 生成 localhost 与 127.0.0.1 两个来源
# CORS_ALLOWED_ORIGIN=http://localhost:8088,http://127.0.0.1:8088

# 经容器 Nginx 反代时必须为 true（默认已开）：否则注册限流按 Nginx 容器 IP 全站共享、
# 审计日志的来源 IP 全部失真为 172.x
APP_TRUST_FORWARDED_HEADER=true
# 是否暴露 /doc.html 与 /v3/api-docs（容器部署默认关闭；本地开发用 application.yml 默认 true）
APP_API_DOCS_ENABLED=false

# —— 邮件通道（默认关闭；关闭时站内通知照常工作）——
MAIL_ENABLED=false
MAIL_FROM=no-reply@libms.local
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
