# 开发环境变量
# VITE_USE_MOCK：是否使用本地 Mock 数据
#   true  = 使用 Mock（后端未就绪时前端可独立运行，仅供开发调试）
#   false = 走真实后端接口（正式联调/开发默认）
VITE_USE_MOCK=false

# 接口基础路径：空 = 使用 /api（经 vite 代理转发到后端 8080，见 vite.config.js）
# 若需直连后端（后端已开启 CORS），可改为完整地址 http://localhost:8080（后端接口无 /api 前缀）
VITE_API_BASE=/api

# 演示账号一键登录（仅开发/答辩演示；生产必须 false，避免一键进入管理员）
VITE_DEMO_QUICK_LOGIN=true
